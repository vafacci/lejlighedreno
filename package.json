{
  "name": "lejlighed-dokumentation",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "images": "node scripts/build-images.mjs",
    "check": "node scripts/check-assets.mjs && node scripts/check-totals.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run check && tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
